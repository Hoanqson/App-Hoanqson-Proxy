<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 9:16 Sky Nature Background Image -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/bg_sky_theme" />
    </item>

    <!-- Subtle Liquid Glass Tint Overlay - Preserving full clarity of cat & meadow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#20000000"
                android:centerColor="#30000000"
                android:endColor="#55000000"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
