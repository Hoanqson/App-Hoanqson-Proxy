<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom bar deep drop shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#33000000" />
        </shape>
    </item>

    <!-- Translucent Oceanic Glass Body -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#2AFFFFFF"
                android:centerColor="#141E3A5F"
                android:endColor="#180B172E"
                android:type="linear" />
            <!-- Polished Specular Top Border -->
            <stroke
                android:width="1.2dp"
                android:color="#55FFFFFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</layer-list>
