<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Neon Cyan Aura Glow -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="70dp"
                android:startColor="#6600F2FE"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- Vibrant Glowing Liquid Core -->
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#00F2FE"
                android:centerColor="#0284C7"
                android:endColor="#0369A1"
                android:type="linear" />
            <stroke
                android:width="2.5dp"
                android:color="#E0F2FE" />
        </shape>
    </item>
</layer-list>
