<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep Drop Shadow & Ambient Tint -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#26040914" />
        </shape>
    </item>

    <!-- Translucent Frosted Glass with Specular Top Highlight -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <!-- Frosted Glass Liquid Fill with subtle deep blur tint for contrast over sky wallpaper -->
            <gradient
                android:angle="135"
                android:startColor="#33FFFFFF"
                android:centerColor="#26081326"
                android:endColor="#33060E1C"
                android:type="linear" />
            <!-- Specular Edge Refraction -->
            <stroke
                android:width="1.2dp"
                android:color="#66FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
