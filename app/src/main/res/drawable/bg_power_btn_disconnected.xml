<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep Glass Cavity -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#24131F37" />
        </shape>
    </item>
    <!-- Frosted Glass Liquid Disc -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#33FFFFFF"
                android:centerColor="#1A2A4365"
                android:endColor="#0F1A2A44"
                android:type="linear" />
            <stroke
                android:width="2dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>
</layer-list>
