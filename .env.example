# ==============================================================================
# Environment Configuration Template (Example)
# DO NOT COMMIT REAL PRODUCTION SECRETS OR SERVICE_ROLE KEYS
# ==============================================================================

# Supabase Project Configuration
# Note: In Android client, only use Publishable / Anon key (safe for client).
# NEVER put service_role or sb_secret here or into the APK!
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_anon_key_here

# HomeProxy API (Default production endpoint: https://app.homeproxy.vn/api/v3/users/rotatev2)
HOMEPROXY_BASE_URL=https://app.homeproxy.vn/api/v3/users/rotatev2
